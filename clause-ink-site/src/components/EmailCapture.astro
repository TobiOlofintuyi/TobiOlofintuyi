---
// Email capture — STORE-AND-FLAG (GR-01).
// No email provider is configured in this repo, so submissions are stored in
// localStorage only. NOTHING leaves the browser. When Tobi picks a provider,
// swapping in the endpoint is a one-function change: see submitToProvider() below.
---
<div class="rounded-2xl border border-ink-800/10 bg-white p-6 sm:p-7 shadow-sm">
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-600">Stay in the loop</p>
  <h3 class="mt-2 text-lg font-semibold text-ink-900">You filed. We'll help you verify it stuck.</h3>
  <p class="mt-2 text-sm text-ink-600 leading-relaxed">
    Leave your email and we'll send you the verification tools as they ship — plus
    the Broker Honor Roll when it opens. We'll only email you about DROP and data
    rights. Nothing else, no sharing.
  </p>
  <form id="email-form" class="mt-4 flex flex-col sm:flex-row gap-2" novalidate>
    <input id="email-input" type="email" required autocomplete="email" placeholder="you@email.com"
      class="flex-1 rounded-lg border border-ink-800/20 px-3.5 py-2.5 text-sm focus:border-teal-500 outline-none" />
    <button type="submit"
      class="rounded-lg bg-ink-900 text-paper-50 text-sm font-semibold px-5 py-2.5 hover:bg-ink-800 transition-colors">
      Keep me posted
    </button>
  </form>
  <p id="email-status" class="mt-2 text-xs h-4" aria-live="polite"></p>
  <p class="mt-1 text-[11px] text-ink-400 leading-relaxed">
    Stored in your browser only until an email provider is connected — see the note
    in the source. This surface is private during the build.
  </p>
</div>
<script>
  const LIST_KEY = 'clause.ink/drop/subscribers/v1';
  const form = document.getElementById('email-form');
  const input = document.getElementById('email-input');
  const status = document.getElementById('email-status');

  // THE ONE DECLARED OUTBOUND SEAM (currently a no-op). When a provider is chosen,
  // implement this to POST { email } to the provider endpoint and return true/false.
  // Until then we store-and-flag locally so nothing leaves the browser.
  async function submitToProvider(_email) {
    return false; // no provider configured yet
  }

  function storeLocally(email) {
    let list = [];
    try { list = JSON.parse(localStorage.getItem(LIST_KEY) || '[]'); } catch { list = []; }
    if (!list.includes(email)) list.push(email);
    localStorage.setItem(LIST_KEY, JSON.stringify(list));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (input.value || '').trim();
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    if (!ok) {
      status.textContent = 'Please enter a valid email address.';
      status.className = 'mt-2 text-xs h-4 text-rose-500';
      return;
    }
    const sent = await submitToProvider(email);
    storeLocally(email);
    status.textContent = sent
      ? "You're on the list. Talk soon."
      : "Saved to this browser. We'll reach out once the list is live.";
    status.className = 'mt-2 text-xs h-4 text-teal-600';
    input.value = '';
  });
</script>
